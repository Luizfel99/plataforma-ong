    {
      "protocol": "mailto",
      "url": "/contato.html?email=%s"
    }
  ],
  
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.example.plataformaong",
      "id": "com.example.plataformaong"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/plataforma-ong/id123456789"
    }
  ],
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  
  "capture_links": "existing-client-navigate",
  
  "file_handlers": [
    {
      "action": "/contato.html",
      "accept": {
        "text/plain": [".txt"],
        "text/csv": [".csv"],
        "application/pdf": [".pdf"]
      },
      "launch_type": "single-client"
    }
  ],
  
  "handle_links": "preferred",
  
