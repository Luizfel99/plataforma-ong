{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run serve",
      "startServerReadyPattern": "Local server running",
      "url": [
        "http://localhost:8080",
        "http://localhost:8080/sobre.html",
        "http://localhost:8080/projetos.html",
        "http://localhost:8080/doacoes.html",
        "http://localhost:8080/voluntariado.html",
        "http://localhost:8080/transparencia.html",
        "http://localhost:8080/contato.html",
        "http://localhost:8080/blog.html"
      ],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "emulatedFormFactor": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        },
        "screenEmulation": {
          "mobile": false,
          "width": 1350,
          "height": 940,
          "deviceScaleFactor": 1,
          "disabled": false
        }
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.9}],
        "categories:seo": ["error", {"minScore": 0.9}],
        "categories:pwa": ["warn", {"minScore": 0.8}],
        
        "first-contentful-paint": ["warn", {"maxNumericValue": 2000}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "total-blocking-time": ["warn", {"maxNumericValue": 300}],
        "speed-index": ["warn", {"maxNumericValue": 3000}],
        
        "uses-responsive-images": "error",
        "uses-optimized-images": "error",
        "uses-webp-images": "warn",
        "efficient-animated-content": "warn",
        "unused-css-rules": "warn",
        "unused-javascript": "warn",
        "modern-image-formats": "warn",
        "uses-long-cache-ttl": "warn",
        "uses-text-compression": "error",
        
        "color-contrast": "error",
        "image-alt": "error",
        "label": "error",
        "link-name": "error",
        "button-name": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "html-lang-valid": "error",
        "meta-description": "error",
        "heading-order": "warn",
        "landmark-one-main": "warn",
        "list": "warn",
        "listitem": "warn",
        "definition-list": "warn",
        "dlitem": "warn",
        "bypass": "warn",
        "focus-traps": "warn",
        "focusable-controls": "warn",
        "interactive-element-affordance": "warn",
        "logical-tab-order": "warn",
        "managed-focus": "warn",
        "offscreen-content-hidden": "warn",
        "use-landmarks": "warn",
        "valid-lang": "warn",
        "video-caption": "warn",
        
        "is-on-https": "error",
        "redirects-http": "warn",
        "uses-http2": "warn",
        "external-anchors-use-rel-noopener": "error",
        "geolocation-on-start": "error",
        "notification-on-start": "error",
        "no-vulnerable-libraries": "error",
        "password-inputs-can-be-pasted-into": "error",
        "csp-xss": "warn",
        "errors-in-console": "warn",
        
        "viewport": "error",
        "robots-txt": "warn",
        "hreflang": "warn",
        "canonical": "warn",
        "font-display": "warn",
        "plugins": "error",
        "crawlable-anchors": "error",
        "tap-targets": "error",
        "structured-data": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}